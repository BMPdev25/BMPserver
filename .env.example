# Database
MONGO_URI=mongodb+srv://your-db-user:your-db-password@your-cluster.mongodb.net/

# JWT
JWT_SECRET=your-super-secret-jwt-key-here-minimum-32-characters

# Razorpay
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Required for POST /api/payment/webhook — without it, any real webhook call
# from Razorpay 500s with "Server webhook configuration error". Set this to
# the signing secret configured for the webhook endpoint in the Razorpay
# dashboard (Settings > Webhooks), not the API key secret above.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-signing-secret

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_PUBLIC_BUCKET=sacredconnect-public
AWS_S3_PRIVATE_BUCKET=sacredconnect-private
AWS_CLOUDFRONT_URL=   # optional — set to CloudFront domain to serve public files via CDN

# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# Email (Optional for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Push Notifications (Optional)
FCM_SERVER_KEY=your-fcm-server-key

# Phone OTP login (optional) — set OTP_ENABLED=true to register the
# /api/auth/send-otp and /api/auth/verify-otp routes at all; if it's not
# "true" those routes aren't mounted (a request to them 404s). When enabled,
# MSG91_API_KEY and MSG91_TEMPLATE_ID are required — smsService.js throws
# 'SMS service is not configured' at send time without them.
OTP_ENABLED=false
MSG91_API_KEY=your-msg91-api-key
MSG91_TEMPLATE_ID=your-msg91-otp-template-id

# Development
NODE_ENV=development
