# Test-only environment. Loaded by tests/setup.js before every test file so
# real credentials from .env (RAZORPAY_LIVE=true, live keys) are never used
# in the test suite — these values always win over .env because setup.js
# loads this file first and dotenv never overwrites an already-set var.
NODE_ENV=test
RAZORPAY_KEY_ID=rzp_test_fake_key_id
RAZORPAY_KEY_SECRET=test_only_hmac_secret_do_not_use_in_prod
RAZORPAY_LIVE=false
MAESTRO_SECRET=test_maestro_secret
OTP_ENABLED=true
